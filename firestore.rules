rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsExisting() {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function ownsIncoming() {
      return signedIn() && request.resource.data.ownerUid == request.auth.uid;
    }

    function validString(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function validNullableString(value, maxLength) {
      return value == null || value is string && value.size() <= maxLength;
    }

    function validOptionalString(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function validPlanData() {
      return request.resource.data.keys().hasOnly([
          'planId',
          'ownerUid',
          'name',
          'yearMonth',
          'passwordHash',
          'publicToken',
          'isActive',
          'createdAt',
          'updatedAt'
        ])
        && validString(request.resource.data.planId, 80)
        && request.resource.data.ownerUid == request.auth.uid
        && validString(request.resource.data.name, 80)
        && request.resource.data.yearMonth.matches('^\\d{4}-(0[1-9]|1[0-2])$')
        && validNullableString(request.resource.data.passwordHash, 240)
        && validString(request.resource.data.publicToken, 80)
        && request.resource.data.isActive is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validEventAdminProfile(uid) {
      return request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'isActive',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == uid
        && validNullableString(request.resource.data.email, 240)
        && validNullableString(request.resource.data.displayName, 120)
        && request.resource.data.isActive is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validEventData() {
      return request.resource.data.keys().hasOnly([
          'eventId',
          'planId',
          'ownerUid',
          'name',
          'eventDate',
          'timeSlot',
          'timeDetail',
          'place',
          'status',
          'sortOrder',
          'isActive',
          'createdAt',
          'updatedAt'
        ])
        && validString(request.resource.data.eventId, 80)
        && validString(request.resource.data.planId, 80)
        && request.resource.data.ownerUid == request.auth.uid
        && validOptionalString(request.resource.data.name, 80)
        && request.resource.data.eventDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.timeSlot in ['AM', 'PM']
        && validOptionalString(request.resource.data.timeDetail, 40)
        && validString(request.resource.data.place, 120)
        && request.resource.data.status in ['accepting', 'closed']
        && request.resource.data.sortOrder is number
        && request.resource.data.isActive is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validGuestData() {
      return request.resource.data.keys().hasOnly([
          'guestId',
          'planId',
          'ownerUid',
          'nickname',
          'nicknameKey',
          'pinHash',
          'pinResetAt',
          'pinResetByUid',
          'createdAt',
          'updatedAt'
        ])
        && validString(request.resource.data.guestId, 80)
        && validString(request.resource.data.planId, 80)
        && request.resource.data.ownerUid == request.auth.uid
        && validString(request.resource.data.nickname, 40)
        && validString(request.resource.data.nicknameKey, 80)
        && validString(request.resource.data.pinHash, 240)
        && (request.resource.data.pinResetAt == null || request.resource.data.pinResetAt is timestamp)
        && validNullableString(request.resource.data.pinResetByUid, 80)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validResponseData() {
      return request.resource.data.keys().hasOnly([
          'responseId',
          'planId',
          'eventId',
          'guestId',
          'ownerUid',
          'isActive',
          'attendanceStatus',
          'comment',
          'answeredAt',
          'lastUpdatedBy',
          'lastUpdatedByUid',
          'createdAt',
          'updatedAt'
        ])
        && validString(request.resource.data.responseId, 180)
        && validString(request.resource.data.planId, 80)
        && validString(request.resource.data.eventId, 80)
        && validString(request.resource.data.guestId, 80)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.isActive is bool
        && request.resource.data.attendanceStatus in ['yes', 'maybe', 'no']
        && (request.resource.data.comment == null || request.resource.data.comment is string && request.resource.data.comment.size() <= 500)
        && request.resource.data.answeredAt is timestamp
        && request.resource.data.lastUpdatedBy in ['admin', 'guest']
        && validNullableString(request.resource.data.lastUpdatedByUid, 80)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validAuditLogData() {
      return request.resource.data.keys().hasOnly([
          'ownerUid',
          'actorType',
          'actorUid',
          'action',
          'targetType',
          'targetId',
          'summary',
          'createdAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.actorType in ['admin', 'guest', 'system']
        && validNullableString(request.resource.data.actorUid, 80)
        && validString(request.resource.data.action, 80)
        && validString(request.resource.data.targetType, 80)
        && validString(request.resource.data.targetId, 180)
        && validNullableString(request.resource.data.summary, 240)
        && request.resource.data.createdAt is timestamp;
    }

    function validNotificationTokenData() {
      return request.resource.data.keys().hasOnly([
          'tokenId',
          'ownerUid',
          'fcmToken',
          'userAgent',
          'isActive',
          'lastSeenAt',
          'createdAt',
          'updatedAt'
        ])
        && validString(request.resource.data.tokenId, 80)
        && request.resource.data.ownerUid == request.auth.uid
        && validString(request.resource.data.fcmToken, 4096)
        && validNullableString(request.resource.data.userAgent, 300)
        && request.resource.data.isActive is bool
        && request.resource.data.lastSeenAt is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /eventAdmins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && validEventAdminProfile(uid);
      allow update: if signedIn()
        && request.auth.uid == uid
        && resource.data.uid == uid
        && validEventAdminProfile(uid);
      allow delete: if false;
    }

    match /plans/{planId} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming()
        && request.resource.data.planId == planId
        && validPlanData();
      allow update: if ownsExisting()
        && ownsIncoming()
        && request.resource.data.planId == resource.data.planId
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.publicToken == resource.data.publicToken
        && request.resource.data.createdAt == resource.data.createdAt
        && validPlanData();
      allow delete: if false;
    }

    match /events/{eventId} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming()
        && request.resource.data.eventId == eventId
        && validEventData();
      allow update: if ownsExisting()
        && ownsIncoming()
        && request.resource.data.eventId == resource.data.eventId
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.planId == resource.data.planId
        && request.resource.data.sortOrder == resource.data.sortOrder
        && request.resource.data.createdAt == resource.data.createdAt
        && validEventData();
      allow delete: if false;
    }

    match /guests/{guestId} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming()
        && request.resource.data.guestId == guestId
        && validGuestData();
      allow update: if ownsExisting()
        && ownsIncoming()
        && request.resource.data.guestId == resource.data.guestId
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.planId == resource.data.planId
        && request.resource.data.nickname == resource.data.nickname
        && request.resource.data.nicknameKey == resource.data.nicknameKey
        && request.resource.data.createdAt == resource.data.createdAt
        && validGuestData();
      allow delete: if false;
    }

    match /responses/{responseId} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming()
        && request.resource.data.responseId == responseId
        && validResponseData();
      allow update: if ownsExisting()
        && ownsIncoming()
        && request.resource.data.responseId == resource.data.responseId
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.planId == resource.data.planId
        && request.resource.data.eventId == resource.data.eventId
        && request.resource.data.guestId == resource.data.guestId
        && request.resource.data.createdAt == resource.data.createdAt
        && validResponseData();
      allow delete: if false;
    }

    match /notificationTokens/{tokenId} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming()
        && request.resource.data.tokenId == tokenId
        && validNotificationTokenData();
      allow update: if ownsExisting()
        && ownsIncoming()
        && request.resource.data.tokenId == resource.data.tokenId
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.fcmToken == resource.data.fcmToken
        && request.resource.data.createdAt == resource.data.createdAt
        && validNotificationTokenData();
      allow delete: if false;
    }

    match /auditLogs/{auditLogId} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming() && validAuditLogData();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
