{
  "name": "rsvp-manager-app",
  "version": "1.1.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:ci": "node scripts/build-ci.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:security": "node --test scripts/security-audit-policy.test.mjs",
    "audit:security": "node scripts/security-audit.mjs",
    "test:sdk": "npx --yes --package=firebase-tools@15.17.0 firebase emulators:exec --only auth,firestore,storage --project demo-rsvp-ci --config firebase-smoke.config.json \"node scripts/firebase-security-smoke.mjs\"",
    "test:e2e": "playwright test",
    "maintenance:delete-plan": "node scripts/maintenance/delete-plan.mjs"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "firebase": "12.14.0",
    "firebase-admin": "^14.5.0",
    "next": "16.3.8",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "25.9.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.6",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "@grpc/grpc-js": "1.14.5",
    "gaxios@6.7.1": {
      "uuid": "11.1.1"
    }
  }
}
